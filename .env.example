# Swarmie environment configuration
# Copy this file to `.env` and fill in your keys.

# Flask security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# ===== LLM API (any OpenAI-compatible provider) =====
# Examples:
#   OpenAI:       https://api.openai.com/v1
#   Anthropic:    use claude via OpenRouter
#   Groq:         https://api.groq.com/openai/v1
#   Together:     https://api.together.xyz/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   Ollama:       http://localhost:11434/v1   (local, free)
#   Alibaba Qwen: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# ===== Zep Cloud (graph memory) =====
# Free tier sufficient for early use: https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== Optional: fast/cheap secondary model for high-volume agent reactions =====
# Leave blank to use the primary model for everything.
# LLM_BOOST_API_KEY=
# LLM_BOOST_BASE_URL=
# LLM_BOOST_MODEL_NAME=
