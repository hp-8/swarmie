# Swarmie environment configuration
# Copy this file to `.env` and fill in your keys.

# ============================================================
# Flask
# ============================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here
FLASK_DEBUG=false

# ============================================================
# LLM — primary / default tier
# Any OpenAI-compatible provider works:
#   OpenAI:        https://api.openai.com/v1
#   Groq:          https://api.groq.com/openai/v1
#   Together:      https://api.together.xyz/v1
#   OpenRouter:    https://openrouter.ai/api/v1
#   Ollama (local, free):  http://localhost:11434/v1
#   DeepSeek:      https://api.deepseek.com/v1
#   Qwen / Alibaba: https://dashscope.aliyuncs.com/compatible-mode/v1
# ============================================================
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# ============================================================
# LLM tier overrides (optional)
# Swarmie routes calls into three tiers for cost efficiency:
#   cheap = 80% of agent reactions   (recommend: Haiku / Qwen-turbo / Llama-3.1-8B)
#   deep  = ~20 "influencer" agents  (recommend: Sonnet / GPT-4.1)
#   synth = final report synthesis   (recommend: Sonnet)
#
# Unset tier vars fall back to the LLM_* primary above.
# Set only what you want to override.
# ============================================================
# LLM_CHEAP_API_KEY=
# LLM_CHEAP_BASE_URL=
# LLM_CHEAP_MODEL_NAME=llama-3.1-8b-instant
#
# LLM_DEEP_API_KEY=
# LLM_DEEP_BASE_URL=
# LLM_DEEP_MODEL_NAME=gpt-4o
#
# LLM_SYNTH_API_KEY=
# LLM_SYNTH_BASE_URL=
# LLM_SYNTH_MODEL_NAME=gpt-4o

# ============================================================
# Fallback provider (used after primary exhausts retries)
# Recommended: Google Gemini via its OpenAI-compatible endpoint.
# Get a key: https://aistudio.google.com/apikey
# ============================================================
# LLM_FALLBACK_API_KEY=your_gemini_key
# LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_FALLBACK_MODEL_NAME=gemini-3.6-flash

# Paid runs (a credit was spent) use Claude through the Anthropic SDK.
# Unset ANTHROPIC_API_KEY -> paid runs use the free provider above.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PAID_MODEL_NAME=claude-opus-5-5          # default for every tier
# LLM_PAID_CHEAP_MODEL_NAME=claude-haiku-5-5   # per tier: CHEAP | DEEP | SYNTH
# LLM_PAID_CHEAP_EFFORT=low                    # low | medium | high | xhigh | max
# LLM_PAID_TIMEOUT=300

# ============================================================
# Zep (optional — required only for deep / legacy simulation mode)
# Fast "roast" pipeline runs without Zep.
# Free tier sufficient for early use: https://app.getzep.com/
# ============================================================
USE_ZEP=false
ZEP_API_KEY=

# ============================================================
# Roast pipeline tuning
# ============================================================
ROAST_AGENT_COUNT=100
ROAST_CONCURRENCY=20
ROAST_MAX_COST_USD=1.00

# Roast job store. Set to a Redis URL (e.g. Upstash rediss://...) so jobs + the
# SSE event log survive worker restarts/redeploys/idle spin-down. Unset → jobs
# live in-process and are lost on restart ("job not found" 404 on /stream).
# REDIS_URL=rediss://default:<token>@<host>:6379
ROAST_JOB_TTL=3600
# A non-terminal job idle this many seconds (pipeline thread died) → failed.
ROAST_STALE_SECONDS=180

# ============================================================
# API hardening (public launch)
# ============================================================
# Comma-separated browser origins allowed to call /api/* (CORS allowlist).
CORS_ORIGINS=https://swarmie.harshpatadia.com,https://swarmie.vercel.app,http://localhost:3000
# Per-IP limit on roast creation (POST /api/roast) — each roast burns LLM tokens.
RATE_LIMIT_ROAST=5 per hour
# Per-IP limit on agent chat (POST .../agents/<id>/chat) — also burns tokens.
RATE_LIMIT_CHAT=30 per hour
# Master switch for rate limiting; set false to disable (tests/CI run with false).
RATE_LIMIT_ENABLED=true

# ============================================================
# Supabase (analytics: run tracking, device fingerprints, PDF downloads)
# Create a project at https://supabase.com → Settings → API
# ============================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- LLM fallback (used when the primary exhausts retries) ----
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL_NAME=

# ---- Runtime / scaling ----
# Upstash Redis URL (rediss://...) so jobs survive restarts; blank = in-memory
REDIS_URL=
MAX_CONCURRENT_ROASTS=4
# Reverse-proxy hops in front of the backend (Render = 1, direct = 0)
TRUSTED_PROXY_HOPS=1
# Frontend -> backend base URL (blank = http://localhost:5001)
VITE_API_BASE_URL=

# ---- Pack-only review types (Investor, Launch) ----
# Keep both false until billing is live; true unlocks for dev/demo
PAID_SWARMS_ENABLED=false
VITE_PAID_SWARMS_ENABLED=false

# ---- Accounts + credits (Supabase, server side) ----
# Same project as VITE_SUPABASE_URL; service role key is SERVER ONLY, never VITE_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Billing (Stripe) ----
# Master switches: keep false until Stripe + Supabase keys are set and the
# billing migration has run. Backend enforces; frontend shows sign-in/buy UI.
BILLING_ENABLED=false
VITE_BILLING_ENABLED=false
# Free reviews: Validate with panels up to this size need no account
FREE_MAX_AGENTS=20
# Launch prices hold for this many paying buyers
LAUNCH_BUYERS=100
# Stripe test/live switch. Both key sets sit side by side; STRIPE_MODE picks one.
# Keys that don't match the mode are refused, and webhook events from the other
# mode are ignored, so test keys can never run live (or grant real credits).
STRIPE_MODE=test
STRIPE_SECRET_KEY_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_WEBHOOK_SECRET_LIVE=
# Legacy single-key form, used only when the mode-specific value is unset
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=
# Where Checkout returns the buyer (frontend origin)
APP_BASE_URL=http://localhost:3000
